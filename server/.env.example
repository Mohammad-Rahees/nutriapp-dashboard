# Server Environment Variables (Render)
NODE_ENV=production
PORT=5000

# Frontend URL for CORS configuration (e.g. https://nutri-app.vercel.app)
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nutridb?retryWrites=true&w=majority

# JWT Secret for Session Authentication
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_TJwGz8Ynnf8h0j
RAZORPAY_KEY_SECRET=P1VrGsXnruW7oksMisi9JDuv

# Initial Master Admin Setup Credentials
